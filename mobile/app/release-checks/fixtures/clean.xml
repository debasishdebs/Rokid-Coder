<?xml version="1.0" encoding="utf-8"?>
<!-- Passes every rule: our own services only, none exported; no plugin query, no cleartext. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.debasishdebs.rokidcoder">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="com.anezium.rokidbus.action.HUB" />
        </intent>
    </queries>
    <application android:usesCleartextTraffic="false">
        <activity android:name="com.anezium.rokidbus.plugin.agents.AgentsSettingsActivity" android:exported="true" />
        <service android:name="com.anezium.rokidbus.plugin.agents.AgentsHubService" android:exported="false" />
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" android:exported="true" />
    </application>
</manifest>
