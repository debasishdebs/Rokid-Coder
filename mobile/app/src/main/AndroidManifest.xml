<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        POST_NOTIFICATIONS is a documented Agents exception to plugins/AGENTS.md
        section 3.5 (R32). It is for one thing only: the visible, low-importance
        notification of the app's one service, with Settings and Stop. Agents
        never posts an alert or a session's text to the phone; alerts belong on
        the glasses.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Push-to-talk. The service asks for the microphone type only while it is granted. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Boot and app update start the service again, connected-device only, once a screen of ours started it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Why the notification is visible, and why the exemption below stays. A
        foreground service whose notification is never shown is not treated as a protected one on every
        ROM: measured on a Vivo device, Android froze this process outright
        (cgroup.freeze=1, no CPU time at all) while the service still reported
        isForeground=true. The kernel kept completing TCP handshakes from its
        backlog, so the daemon saw connections that never answered hello and
        redialled forever. The exemption is what stops that, and the settings
        screen asks for it rather than assuming it.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <queries>
        <!-- Package visibility so the away-from-home setup can tell whether
             Tailscale is already on this phone. -->
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:name=".RokidCoderApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_agents"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Agents"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".AgentsSettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AddComputerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ComputerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProjectPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NewThreadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The app's only service: the glasses link, the Agents code and the agentd links. Nothing
            outside the app starts or binds it; the microphone type is held only where Android allows.
        -->
        <service
            android:name=".service.CoderService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <receiver
            android:name=".service.CoderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
